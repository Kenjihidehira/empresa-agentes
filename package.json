{
  "name": "empresa-agentes",
  "version": "1.0.0",
  "private": true,
  "description": "Empresa virtual de software operada por agentes de IA, com escritório em cubículos estilo terminal.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "npm run build && cross-env NODE_ENV=production tsx server/index.ts",
    "test": "cross-env DB_PATH=:memory: SIM_PASSO_MS=15 NODE_NO_WARNINGS=1 tsx --test server/tests/*.test.ts",
    "reset": "tsx server/reset.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
